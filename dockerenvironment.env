# Optional FIRST-BOOT SEED values. This file is NOT loaded by default.
# WebUI /config/settings.json becomes authoritative after initialization.
# Database selection/credentials are stored in /config/database.json.
# Never place real passwords into a committed file.
# Do not add this file to Compose env_file by default: a blank install should
# begin at /setup and persist its preferences under /config.
PROBE_INTERVAL=30
PING_COUNT=4
SITES=fast.com,google.com,youtube.com,amazon.com
DNS_TEST_SITE=google.com
WEIGHT_LOSS=0.6
WEIGHT_LATENCY=0.15
WEIGHT_JITTER=0.2
WEIGHT_DNS_LATENCY=0.05
SPEEDTEST_ENABLED=true
SPEEDTEST_INTERVAL=14400
SPEEDTEST_BACKEND=python
# These optional values seed MONITORING settings only when an env_file block
# is enabled in the selected Compose service.
# PostgreSQL infrastructure credentials belong in a separate UNTRACKED .env:
#   POSTGRES_PASSWORD=<unique-random-value>
#   POSTGRES_DB=netprobe       # optional; defaults to netprobe
#   POSTGRES_USER=netprobe     # optional; defaults to netprobe
# Do not add a real password to this tracked example or duplicate Compose's
# DB_ENGINE/POSTGRES_* values in the WebUI's managed settings JSON.
# Do not set I_ACCEPT: only the actual end user may accept Ookla terms.
